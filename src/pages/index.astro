---
import EarthworksLayout from '../layouts/EarthworksLayout.astro';
---
<EarthworksLayout title="Digmore | Excavator teeth and wear parts">
  <main id="main-content" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">Excavator teeth and wear parts</p>
        <h1 id="hero-title">Dig more.<br />Build more.</h1>
        <p class="hero-description">The right part for your machine.</p>
        <p class="hero-detail">Explore teeth, side cutters and adapters for excavators and backhoes. Find your part or speak to our team about fitment.</p>
        <div class="hero-actions">
          <a class="button button-primary" href="/products">Explore products <span aria-hidden="true">→</span></a>
          <a class="button button-outline" href="/contact">Make an enquiry</a>
        </div>
      </div>
      <figure class="hero-visual">
        <!-- Application photograph only: not represented as a Digmore machine or part. -->
        <img
          class="hero-image"
          src="https://images.pexels.com/photos/20760025/pexels-photo-20760025.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1200"
          srcset="https://images.pexels.com/photos/20760025/pexels-photo-20760025.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=480 480w, https://images.pexels.com/photos/20760025/pexels-photo-20760025.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=800 800w, https://images.pexels.com/photos/20760025/pexels-photo-20760025.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1200 1200w, https://images.pexels.com/photos/20760025/pexels-photo-20760025.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1800 1800w"
          sizes="(max-width: 799px) 100vw, 50vw"
          alt="Yellow excavator lifting rock in its bucket above a field of large stones"
          width="1200" height="1800" loading="eager" fetchpriority="high" decoding="async"
        />
      </figure>
    </section>
    <div class="photo-credit container"><a href="https://images.pexels.com/photos/20760025/pexels-photo-20760025.jpeg?cs=srgb&amp;dl=pexels-gowtham-agm-609630353-20760025.jpg&amp;fm=jpg" target="_blank" rel="noopener noreferrer">Application photography: Gowtham AGM / Pexels</a></div>

    <section class="section product-range container" id="product-range" aria-labelledby="range-title">
      <div class="section-heading"><div><h2 id="range-title">Find your wear parts</h2><p>Choose a category to explore the Digmore range.</p></div><a class="text-link" href="/products">View all products <span aria-hidden="true">→</span></a></div>
      <div class="product-grid">
        <a class="product-card" href="/products"><h3>Excavator teeth</h3><p>Standard and rock-chisel profiles for different applications.</p><p class="product-models">JCB · PC200 · EX200 · CAT</p><span class="card-link">Explore teeth <span aria-hidden="true">→</span></span></a>
        <a class="product-card" href="/products"><h3>Side cutters</h3><p>Left- and right-hand wear parts for your bucket assembly.</p><p class="product-models">JCB · CAT 424</p><span class="card-link">Explore side cutters <span aria-hidden="true">→</span></span></a>
        <a class="product-card" href="/products"><h3>Adapters</h3><p>Match your tooth profile to the correct bucket adapter.</p><p class="product-models">PC71 / EX70 · PC200 · EX200</p><span class="card-link">Explore adapters <span aria-hidden="true">→</span></span></a>
      </div>
      <p class="range-footnote">Model names are selection guides. Confirm part number, dimensions and fitment before ordering.</p>
    </section>

    <section class="application-section" aria-labelledby="fit-title">
      <div class="container application-inner">
        <div class="application-intro"><p class="eyebrow">Parts support</p><h2 id="fit-title">Find the right fit<br />for your machine</h2><p>Not sure which part you need? Send us your machine and part details. Our team will help you check the match before you order.</p><a class="button button-primary" href="https://wa.me/919410105848?text=Hello%20Digmore%2C%20please%20help%20me%20match%20a%20wear%20part.%0AMachine%20model%3A%20%0APart%20number%3A%20%0AApplication%3A%20%0AQuantity%3A%20" target="_blank" rel="noopener noreferrer">Discuss on WhatsApp <span aria-hidden="true">→</span></a></div>
        <ol class="fit-steps"><li><h3>Machine and model</h3><p>Share the make and model of your excavator or backhoe.</p></li><li><h3>Part and fitment</h3><p>Send the part number, dimensions or clear photos of the existing part.</p></li><li><h3>Application and quantity</h3><p>Tell us what you dig, how many parts you need and where to deliver.</p></li></ol>
      </div>
    </section>

    <section class="section closing-section container" aria-labelledby="closing-title"><div><h2 id="closing-title">Let's discuss your requirement</h2><p>Product enquiries, fitment questions or bulk orders.<br />Speak directly with the Digmore team.</p></div><div class="closing-actions"><a class="button button-primary" href="/contact">Contact sales <span aria-hidden="true">→</span></a><a class="text-link" href="/about">About Digmore <span aria-hidden="true">→</span></a></div></section>
  </main>
</EarthworksLayout>
